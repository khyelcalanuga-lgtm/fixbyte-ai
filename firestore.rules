rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /accounts/{uid}/{kind}/{id} {
      function owner() {
        return request.auth != null && request.auth.uid == uid
          && kind in ['gadgets', 'history'];
      }
      function text(value, maximum) {
        return value is string && value.size() <= maximum;
      }
      function validGadget(value) {
        return value is map && value.keys().hasAll(['id', 'name', 'kind', 'added'])
          && value.keys().hasOnly(['id', 'name', 'kind', 'added'])
          && value.id == id && text(value.name, 1000) && text(value.kind, 100)
          && text(value.added, 40);
      }
      function validCheck(value) {
        return value is map && value.keys().hasAll(['id', 'gadget', 'date', 'title', 'detail', 'status'])
          && value.keys().hasOnly(['id', 'gadget', 'date', 'title', 'detail', 'status'])
          && value.id == id && text(value.gadget, 128) && text(value.date, 40)
          && text(value.title, 10000) && text(value.detail, 200000)
          && value.status in ['fixed', 'checked', 'pro'];
      }
      allow read, delete: if owner();
      // Keep a deletion marker so a legacy device cannot import an item that was already removed.
      allow create, update: if owner() && id.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.keys().hasAll(['value'])
        && request.resource.data.keys().hasOnly(['value'])
        && (request.resource.data.value == null
          || (kind == 'gadgets' ? validGadget(request.resource.data.value) : validCheck(request.resource.data.value)));
    }

    match /accounts/{uid}/conversations/{id} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validHead(value) {
        return value is map && value.keys().hasAll(['version', 'parts'])
          && value.keys().hasOnly(['version', 'parts'])
          && value.version is string && value.version.matches('^[A-Za-z0-9_-]{1,128}$')
          && value.parts is int && value.parts >= 0 && value.parts <= 10000;
      }
      allow read, delete: if owner();
      allow create, update: if owner() && id.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.keys().hasAll(['value']) && request.resource.data.keys().hasOnly(['value'])
        && (request.resource.data.value == null || validHead(request.resource.data.value));

      match /parts/{part} {
        allow read, delete: if owner();
        allow create, update: if owner() && part.matches('^[A-Za-z0-9_-]{1,150}$')
          && request.resource.data.keys().hasAll(['version', 'index', 'data'])
          && request.resource.data.keys().hasOnly(['version', 'index', 'data'])
          && request.resource.data.version is string && request.resource.data.version.matches('^[A-Za-z0-9_-]{1,128}$')
          && request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.index < 10000
          && request.resource.data.data is string && request.resource.data.data.size() <= 200000;
      }
    }

    match /profiles/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow get, delete: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasAll(['avatarColor'])
        && request.resource.data.keys().hasOnly(['avatarColor'])
        && request.resource.data.avatarColor in ['#7CEB5A', '#93C5FD', '#C4B5FD', '#FDA4AF', '#FDBA74', '#FDE047'];
    }

    match /dailyUsage/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validCount() {
        return request.resource.data.keys().hasAll(['day', 'used'])
          && request.resource.data.keys().hasOnly(['day', 'used'])
          && request.resource.data.day == request.time.date()
          && request.resource.data.used is int
          && request.resource.data.used >= 1
          && request.resource.data.used <= 3;
      }

      allow get: if owner();
      allow create: if owner() && validCount() && request.resource.data.used == 1;
      allow update: if owner() && validCount()
        && (resource.data.day == request.time.date()
          ? request.resource.data.used == resource.data.used + 1
          : request.resource.data.used == 1);
    }
  }
}
