{
  "expo": {
    "name": "FixByte AI",
    "slug": "fixbyte-ai",
    "version": "1.0.2",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.fixbyte.ai",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "scheme": "fixbyteai",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F3F3",
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "FixByte AI needs your photos to diagnose damaged hardware."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 144,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#1C1C1F"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FixByte AI uses your location to find repair shops near you."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://fixbyte-ai.expo.app",
      "router": {},
      "eas": {
        "projectId": "f83f5e20-3fb7-452a-8513-0051fc2fa86f"
      }
    },
    "owner": "khyell"
  }
}
