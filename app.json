{
  "expo": {
    "name": "FixByte AI",
    "slug": "fixbyte-ai",
    "scheme": "fixbyteai",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F3F3",
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "FixByte AI needs your photos to diagnose damaged hardware."
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FixByte AI uses your location to find repair shops near you."
        }
      ]
    ]
  }
}
