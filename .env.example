# One key, or several comma-separated: when one runs out of quota the next takes over.
GEMINI_API_KEY=your-gemini-key

# Backup when Gemini is down: free OpenRouter models (comma-separate several keys too).
OPENROUTER_API_KEY=your-openrouter-key

# Android builds: public URL of the server running this app's API routes.
# For a LAN test, use http://YOUR_COMPUTER_IP:8081 (phone on the same network).
EXPO_PUBLIC_API_URL=https://your-app.example.com
