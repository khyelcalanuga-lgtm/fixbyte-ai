# AI providers, tried in this order until one answers. Leave one out and it's skipped.
# Each takes one key, or several comma-separated: when one runs out of quota the next takes over.
# The hosted server reads these from EAS env vars instead (see ANDROID.md).

# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# https://console.groq.com/keys  (free, very fast)
GROQ_API_KEY=your-groq-key
# https://console.mistral.ai/api-keys  (free "Experiment" plan)
MISTRAL_API_KEY=your-mistral-key
# https://github.com/settings/personal-access-tokens  (fine-grained token with the "Models: read" permission)
GITHUB_MODELS_TOKEN=your-github-token
# https://openrouter.ai/keys  (free models are slow: last resort)
OPENROUTER_API_KEY=your-openrouter-key

# Android builds: public URL of the server running this app's API routes.
# For a LAN test, use http://YOUR_COMPUTER_IP:8081 (phone on the same network).
EXPO_PUBLIC_API_URL=https://your-app.example.com
